    style flowDatabase fill:#fff4df,stroke:#b48a38,color:#6c501d,stroke-width:1.5px
    style engines fill:#f8fcfa,stroke:#a7c8ba,stroke-width:1px
    style organization fill:#f1f8f5,stroke:#527c6e,stroke-width:2px,color:#244f43
